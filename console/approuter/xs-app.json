{
    "welcomeFile": "/index.html",
    "authenticationMethod": "route",
    "routes": [
        {
            "source": "^/api/(.*)$",
            "target": "/api/$1",
            "destination": "backend",
            "authenticationType": "xsuaa",
            "csrfProtection": false
        },
        {
            "source": "^/settings/(.*)$",
            "target": "/settings/$1",
            "destination": "backend",
            "authenticationType": "xsuaa",
            "csrfProtection": false
        },
        {
            "source": "^(.*)$",
            "localDir": "resources",
            "authenticationType": "xsuaa"
        }
    ]
}