<?xml version="1.0" encoding="utf-8"?>
<edmx:Edmx Version="4.0" xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx">
  <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/Common.xml">
    <edmx:Include Alias="Common" Namespace="com.sap.vocabularies.Common.v1"/>
  </edmx:Reference>
  <edmx:Reference Uri="https://oasis-tcs.github.io/odata-vocabularies/vocabularies/Org.OData.Core.V1.xml">
    <edmx:Include Alias="Core" Namespace="Org.OData.Core.V1"/>
  </edmx:Reference>
  <edmx:DataServices>
    <Schema Namespace="ChatService" xmlns="http://docs.oasis-open.org/odata/ns/edm">
      <Annotation Term="Core.Links">
        <Collection>
          <Record>
            <PropertyValue Property="rel" String="author"/>
            <PropertyValue Property="href" String="https://cap.cloud.sap"/>
          </Record>
        </Collection>
      </Annotation>
      <EntityContainer Name="EntityContainer">
        <ActionImport Name="chat" Action="ChatService.chat"/>
        <FunctionImport Name="userinfo" Function="ChatService.userinfo"/>
        <FunctionImport Name="skills" Function="ChatService.skills"/>
        <FunctionImport Name="getSkill" Function="ChatService.getSkill"/>
        <ActionImport Name="saveSkill" Action="ChatService.saveSkill"/>
      </EntityContainer>
      <ComplexType Name="EnvSettings">
        <Property Name="brainId" Type="Edm.String"/>
        <Property Name="ntid" Type="Edm.String"/>
        <Property Name="customPrompt" Type="Edm.String"/>
        <Property Name="theme" Type="Edm.String"/>
        <Property Name="skill" Type="Edm.String"/>
      </ComplexType>
      <ComplexType Name="ChatResponse">
        <Property Name="reply" Type="Edm.String"/>
        <Property Name="hisID" Type="Edm.String"/>
      </ComplexType>
      <ComplexType Name="UserDetails">
        <Property Name="username" Type="Edm.String"/>
        <Property Name="email" Type="Edm.String"/>
        <Property Name="firstName" Type="Edm.String"/>
        <Property Name="lastName" Type="Edm.String"/>
      </ComplexType>
      <ComplexType Name="SkillContent">
        <Property Name="content" Type="Edm.String"/>
      </ComplexType>
      <Action Name="chat" IsBound="false">
        <Parameter Name="message" Type="Edm.String"/>
        <Parameter Name="env" Type="ChatService.EnvSettings"/>
        <Parameter Name="option" Type="Edm.String"/>
        <Parameter Name="reLoad" Type="Edm.Boolean"/>
        <Parameter Name="objectType" Type="Edm.String"/>
        <Parameter Name="objectName" Type="Edm.String"/>
        <Parameter Name="error" Type="Edm.String"/>
        <Parameter Name="historyID" Type="Edm.String"/>
        <ReturnType Type="ChatService.ChatResponse"/>
      </Action>
      <Function Name="userinfo" IsBound="false" IsComposable="false">
        <ReturnType Type="ChatService.UserDetails"/>
      </Function>
      <Function Name="skills" IsBound="false" IsComposable="false">
        <ReturnType Type="Collection(Edm.String)" Nullable="true"/>
      </Function>
      <Function Name="getSkill" IsBound="false" IsComposable="false">
        <Parameter Name="filename" Type="Edm.String"/>
        <ReturnType Type="ChatService.SkillContent"/>
      </Function>
      <Action Name="saveSkill" IsBound="false">
        <Parameter Name="filename" Type="Edm.String"/>
        <Parameter Name="content" Type="Edm.String"/>
        <ReturnType Type="Edm.Boolean"/>
      </Action>
      <Annotations Target="ChatService.getSkill(Edm.String)/filename">
        <Annotation Term="Core.OptionalParameter">
          <Record Type="Core.OptionalParameterType"/>
        </Annotation>
      </Annotations>
    </Schema>
  </edmx:DataServices>
</edmx:Edmx>