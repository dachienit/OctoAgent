# Environment Configuration Template
# Copy this file to .env and fill in the actual values
# WARNING: Never commit .env file to git!

# ============================================
# DIA Brain API Configuration
# ============================================
# Get these credentials from your DIA Brain API administrator

# OAuth2 Token Endpoint
URL_TOKEN=https://example.com/oauth/token

# OAuth2 Client Credentials
CLIENT_ID=your-client-id-here
CLIENT_SECRET=your-client-secret-here
SCOPE=your-scope-here
GRANT_TYPE=client_credentials

# DIA Brain API Endpoints
DIA_HISTORY=https://ews-emea.api.bosch.com/it/application/dia-brain/v1/api/chat-histories
DIA_CHAT_RAG=https://ews-emea.api.bosch.com/it/application/dia-brain/v1/api/chat/retrieval-augmented

# Brain ID (provided by DIA Brain administrator)
BRAIN_ID=your-brain-id-here

# ============================================
# SAP System Configuration (for local testing)
# ============================================
# These are used when connecting to SAP via MCP
# SAP_HOST=your-sap-host
# SAP_PORT=443
# SAP_CLIENT=100
# SAP_USER=your-username
# SAP_PASSWORD=your-password

# ============================================
# Local Development Settings
# ============================================
# Port for local development server (default: 4004)
# PORT=4004

# Enable debug logging (true/false)
# DEBUG=true
