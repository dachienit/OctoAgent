{
    "xsappname": "octo-agent",
    "tenant-mode": "dedicated",
    "scopes": [
        {
            "name": "$XSAPPNAME.user",
            "description": "Authenticated user"
        }
    ],
    "role-templates": [
        {
            "name": "User",
            "description": "Basic access",
            "scope-references": [
                "$XSAPPNAME.user"
            ]
        }
    ],
    "role-collections": [
        {
            "name": "OctoAgent_User",
            "description": "Octo Agent User (auto-assigned to all users)",
            "role-template-references": [
                "$XSAPPNAME.User"
            ]
        }
    ],
    "oauth2-configuration": {
        "redirect-uris": [
            "https://*.cfapps.eu10-004.hana.ondemand.com/**",
            "https://*.hana.ondemand.com/**"
        ],
        "grant-types": [
            "authorization_code"
        ]
    }
}